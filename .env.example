# Server-only configuration. Never expose service keys or OAuth secrets in VITE_*.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_KEY=
SALESOS_ADMIN_EMAILS=admin@example.com
SALESOS_DEV_MODE=false
# Also supply this value at build time for deployments behind a proxy.
SALESOS_PUBLIC_URL=http://localhost:5173
# Vercel request body cap is 4.5 MB; leave room for multipart/JSON overhead.
SALESOS_MAX_FILE_BYTES=4194304
# PC uploads use Base64, increasing the file payload by about one third.
SALESOS_DEVICE_MAX_FILE_BYTES=3145728
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CHATKIT_DOMAIN_KEY=local-dev
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
INTERNAL_API_KEY=
