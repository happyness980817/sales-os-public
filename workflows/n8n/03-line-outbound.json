{
  "name": "SALES-OS · RECOVERY ONLY · LINE outbox delivery",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "salesos-12",
      "name": "Recovery only - every 30 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "notes": "Leave this workflow unpublished during normal operation. Manually recover pending work when required.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Edit this non-secret origin after import. Do not put tokens in this node.\nconst apiBase = 'https://REPLACE-SALES-OS-HOST.invalid';\nif (apiBase.includes('REPLACE-') || !/^https:\\/\\/[^\\s/?#@]+(?::\\d+)?$/.test(apiBase)) {\n  throw new Error('Configure SALES-OS URL: enter the public HTTPS origin without a trailing slash.');\n}\nconst item = $input.first();\nreturn [{ ...item, json: { ...item.json, api_base: apiBase } }];"
      },
      "id": "salesos-13",
      "name": "Configure SALES-OS URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.api_base + '/api/internal/line/outbound/claim' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": false,
              "neverError": false,
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "salesos-14",
      "name": "Claim one outbound message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_INTERNAL_CREDENTIAL_ID",
          "name": "SALES-OS internal bearer"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const message = $input.first().json.message;\nif (message === null) return [];\nif (!message || !/^[a-f0-9]{64}$/.test(message.id || '') ||\n    !/^U[a-fA-F0-9]{32}$/.test(message.to || '') ||\n    !/^[a-fA-F0-9]{8}-(?:[a-fA-F0-9]{4}-){3}[a-fA-F0-9]{12}$/.test(message.retry_key || '') ||\n    !/^[A-Za-z0-9_-]{20,200}$/.test(message.lease_token || '') ||\n    !Array.isArray(message.messages) || message.messages.length < 1 || message.messages.length > 5 ||\n    message.messages.some(m => !m || m.type !== 'text' || typeof m.text !== 'string' || !m.text.length || m.text.length > 5000)) {\n  throw new Error('Invalid backend outbox contract. No LINE message was sent.');\n}\n// The backend chooses and verifies the owner -> LINE user mapping; never infer or replace it here.\nreturn [{ json: { api_base: $('Configure SALES-OS URL').first().json.api_base, message } }];"
      },
      "id": "salesos-15",
      "name": "Validate claimed message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.line.me/v2/bot/message/push",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: $json.message.to, messages: $json.message.messages }) }}",
        "options": {
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Line-Retry-Key",
              "value": "={{ $json.message.retry_key }}"
            }
          ]
        }
      },
      "id": "salesos-16",
      "name": "Push claimed message to LINE",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_LINE_CREDENTIAL_ID",
          "name": "SALES-OS LINE channel bearer"
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": false
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const response = $input.first().json;\nconst claimed = $('Validate claimed message').first(0, $runIndex).json;\nconst status = Number(response.statusCode);\nconst headers = response.headers || {};\nconst previous = Object.entries(headers).find(([key]) => key.toLowerCase() === 'x-line-accepted-request-id')?.[1];\nconst accepted = (status >= 200 && status < 300) ||\n  (status === 409 && typeof previous === 'string' && previous.length > 0);\nreturn [{ json: { api_base: claimed.api_base, id: claimed.message.id,\n  result: { accepted, lease_token: claimed.message.lease_token } } }];"
      },
      "id": "salesos-17",
      "name": "Record LINE acceptance",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.api_base + '/api/internal/line/outbound/' + encodeURIComponent($json.id) + '/result' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.result) }}",
        "options": {
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": false,
              "neverError": false,
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "salesos-18",
      "name": "Acknowledge outbound lease",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_INTERNAL_CREDENTIAL_ID",
          "name": "SALES-OS internal bearer"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const result = $input.first().json;\nif (result.ok !== true) throw new Error('Backend did not acknowledge outbound result.');\nif (result.status !== 'succeeded' && result.duplicate !== true) {\n  throw new Error('LINE did not accept delivery. Backend recorded the failure; use recovery after resolving it.');\n}\nreturn [{ json: { ok: true, status: result.status || 'already_recorded' } }];"
      },
      "id": "salesos-19",
      "name": "Validate acknowledgement",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ]
    }
  ],
  "connections": {
    "Configure SALES-OS URL": {
      "main": [
        [
          {
            "node": "Claim one outbound message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim one outbound message": {
      "main": [
        [
          {
            "node": "Validate claimed message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate claimed message": {
      "main": [
        [
          {
            "node": "Push claimed message to LINE",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Push claimed message to LINE": {
      "main": [
        [
          {
            "node": "Record LINE acceptance",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Record LINE acceptance": {
      "main": [
        [
          {
            "node": "Acknowledge outbound lease",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Acknowledge outbound lease": {
      "main": [
        [
          {
            "node": "Validate acknowledgement",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Recovery only - every 30 minutes": {
      "main": [
        [
          {
            "node": "Configure SALES-OS URL",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "pinData": {},
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Seoul",
    "executionTimeout": 300,
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveManualExecutions": false,
    "saveExecutionProgress": false
  },
  "tags": []
}
