    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const message = $input.first().json.message;\nif (message === null) return [];\nif (!message || !/^[a-f0-9]{64}$/.test(message.id || '') ||\n    !/^U[a-fA-F0-9]{32}$/.test(message.to || '') ||\n    !/^[a-fA-F0-9]{8}-(?:[a-fA-F0-9]{4}-){3}[a-fA-F0-9]{12}$/.test(message.retry_key || '') ||\n    !/^[A-Za-z0-9_-]{20,200}$/.test(message.lease_token || '') ||\n    !Array.isArray(message.messages) || message.messages.length < 1 || message.messages.length > 5 ||\n    message.messages.some(m => !m || m.type !== 'text' || typeof m.text !== 'string' || !m.text.length || m.text.length > 5000)) {\n  throw new Error('Invalid backend outbox contract. No LINE message was sent.');\n}\n// The backend chooses and verifies the owner -> LINE user mapping; never infer or replace it here.\nreturn [{ json: { api_base: $('Configure SALES-OS URL').first().json.api_base, message } }];"
