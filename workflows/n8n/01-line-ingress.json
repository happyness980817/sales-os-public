    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const response = $input.first().json;\nconst status = Number(response.statusCode);\nconst body = response.body;\nif (status >= 200 && status < 300 && body && typeof body === 'object' && body.ok === true) {\n  const accepted = Number.isInteger(body.accepted) && body.accepted > 0;\n  const duplicate = Number.isInteger(body.duplicates) && body.duplicates > 0;\n  return [{ json: { statusCode: 200, responseBody: { ok: true }, processWork: accepted || duplicate } }];\n}\nconst statusCode = [400, 401, 403, 413].includes(status) ? status : 503;\nreturn [{ json: { statusCode, responseBody: { ok: false, error: 'event_not_accepted' }, processWork: false } }];"
      },
