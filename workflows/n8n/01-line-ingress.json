        "jsCode": "const response = $input.first().json;\nconst claimed = $('Validate claimed message').first(0, $runIndex).json;\nconst status = Number(response.statusCode);\nconst headers = response.headers || {};\nconst previous = Object.entries(headers).find(([key]) => key.toLowerCase() === 'x-line-accepted-request-id')?.[1];\nconst accepted = (status >= 200 && status < 300) ||\n  (status === 409 && typeof previous === 'string' && previous.length > 0);\nreturn [{ json: { api_base: claimed.api_base, id: claimed.message.id,\n  result: { accepted, lease_token: claimed.message.lease_token } } }];"
