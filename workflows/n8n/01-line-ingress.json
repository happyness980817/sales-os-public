    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $input.first();\nconst fail = (statusCode, error) => [{ json: { forward: false, statusCode, responseBody: { ok: false, error } } }];\nconst headers = item.json.headers || {};\nconst signature = Object.entries(headers).find(([key]) => key.toLowerCase() === 'x-line-signature')?.[1];\nif (typeof signature !== 'string' || !/^[A-Za-z0-9+/]{43}=$/.test(signature)) return fail(401, 'invalid_signature');\nif (!item.binary?.data) return fail(500, 'raw_body_unavailable');\nlet raw;\ntry { raw = await this.helpers.getBinaryDataBuffer(0, 'data'); }\ncatch { return fail(500, 'raw_body_unavailable'); }\nif (!raw || raw.length === 0) return fail(400, 'empty_body');\nif (raw.length > 1000000) return fail(413, 'body_too_large');\n// Never stringify item.json.body: LINE signs the original bytes, including whitespace.\nreturn [{ json: { forward: true, api_base: item.json.api_base,\n  envelope: { raw_body_base64: raw.toString('base64'), signature } } }];"
      },
