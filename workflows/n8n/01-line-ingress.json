      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const result = $input.first().json;\nif (!Number.isInteger(result.processed) || result.processed < 0 || result.processed > 3) {\n  throw new Error('Invalid reconcile response.');\n}\nconst more = result.busy === true || result.processed === 3;\n// One execution: retry a busy worker or a full batch at most 12 times.\nif (more && $runIndex >= 12) {\n  throw new Error('Queue processing limit reached after webhook acknowledgement. Use recovery workflow for remaining jobs.');\n}\nreturn [{ json: { api_base: $('Configure SALES-OS URL').first().json.api_base, retry_reconcile: more } }];"
